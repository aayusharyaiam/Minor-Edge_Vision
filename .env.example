# Copy to .env and restart the server after changing anything.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Face match: cosine similarity between SFace embeddings (-1..1).
# Same person is usually 0.6-0.99, different people usually < 0.3.
# Raise it to be stricter, lower it if you are not being recognised.
MATCH_THRESHOLD=0.40
DETECTION_SCORE=0.80
MIN_FACE_SIZE=60

# Mock hardware timings (seconds)
RELAY_SECONDS=10
APPROVAL_SECONDS=90

# Optional: require an X-API-Key header on every API call.
ADMIN_API_KEY=
